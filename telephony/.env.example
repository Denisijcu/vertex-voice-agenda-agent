# ---------- Centralita (Asterisk en Docker) ----------
# IP de tu PC que ve el celular. Wi-Fi: 172.20.20.20 · Tailscale: 100.95.58.114 (si el celular tiene Tailscale)
HOST_IP=172.20.20.20
# Usuario y clave con los que Linphone se registra en la centralita
SIP_USER=denis
SIP_PASSWORD=cambia-esta-clave
# Dónde escucha la pasarela Python (Asterisk la alcanza por host.docker.internal)
GATEWAY_ADDR=host.docker.internal:9092

# ---------- Pasarela de voz (Python) ----------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9092
# API del agente (la de siempre, puerto 8015). MODEL_NAME vacío = LLM_DEFAULT_MODEL de api\.env
API_URL=http://127.0.0.1:8015
MODEL_NAME=
# En nombre de quién llama el agente (se dice en el aviso inicial)
PRINCIPAL_NAME=Denis Sánchez
# Oído: faster-whisper en CPU (tiny | base | small | medium). small = buen equilibrio en español
WHISPER_MODEL=small
WHISPER_DIR=models/whisper
# Voz: modelo Piper en español (se baja con el comando del README)
PIPER_VOICE=models/piper/es_MX-ald-medium.onnx
# Detección de voz: energía mínima para considerar que alguien habla, y silencio que cierra la frase
VAD_UMBRAL=600
VAD_SILENCIO_MS=800
# Ficha de la llamada (a quién, para qué, notas)
LLAMADA_FILE=llamada.json
