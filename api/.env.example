# Entorno y servidor API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8015

# Endpoint local de inferencia (LM Studio / compatible OpenAI)
# LLM_DEFAULT_MODEL se usa cuando la petición no trae model_name. Debe coincidir con el identificador del
# modelo cargado en LM Studio.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_DEFAULT_MODEL=vertex-voice-agenda
LLM_TIMEOUT_SEC=45.0
MAX_CONCURRENT_CALLS=2
# Muestreo (los mismos del chat de LM Studio). Sin repeat_penalty el modelo puede entrar en bucle.
LLM_TOP_P=0.95
LLM_TOP_K=40
LLM_REPEAT_PENALTY=1.1
# Salida estructurada: LM Studio obliga al modelo a escribir solo el JSON acordado (recomendado: true)
LLM_STRUCTURED_OUTPUT=true

# Orígenes permitidos para CORS (separados por coma, sin '*')
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Agenda: en nombre de quién llama el agente y ventana por defecto (siguiente día hábil, hora local del PC)
PRINCIPAL_NAME=Denis Sánchez
DEFAULT_WINDOW_START_HOUR=9
DEFAULT_WINDOW_END_HOUR=12

# Llamadas reales desde la UI (telephony/). La API usa docker exec contra el contenedor de Asterisk.
TELEPHONY_DOCKER_BIN=docker
TELEPHONY_CONTAINER=vva-asterisk
TELEPHONY_SIP_USER=denis
TELEPHONY_TICKET_TTL_SEC=90

# Puente SIP / RTP. Con SIP_BRIDGE_ENABLED=false todo es dry-run (no marca ni escribe en la agenda real).
SIP_BRIDGE_ENABLED=false
SIP_REGISTRAR_HOST=127.0.0.1
SIP_REGISTRAR_PORT=5061
SIP_TRANSPORT=SIPS/TLS
SIP_DOMAIN=vertex.local
SIP_USERNAME=
SIP_AUTH_SECRET=

RTP_BIND_IP=127.0.0.1
RTP_PORT_MIN=20000
RTP_PORT_MAX=20100
RTP_CODEC=PCMU/8000
RTP_USE_SRTP=true
